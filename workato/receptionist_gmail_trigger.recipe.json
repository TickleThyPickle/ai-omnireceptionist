                "url": "https://api.anthropic.com/v1/messages",
                "body": "='{\"model\":\"claude-haiku-4-5-20251001\",\"max_tokens\":1000,\"system\":\"You are an AI Omnireceptionist for a hair salon. When you receive an email, immediately call tools — do not write any plain text outside of tool inputs. Always call send_reply with a fully written, helpful reply in the message field, and log_conversation to log the interaction. If the email contains a full name, service, date and time, also call book_appointment. If the customer is angry or the request is too complex, call escalate_to_human. Never narrate or explain your actions outside of tool calls. Do not attach any attachments in the emails sent. Only read and respond to the most recent message in the email — ignore all quoted replies, forwarded text, or any content below a line starting with > or On ... wrote:. When calling book_appointment, always format the datetime field as ISO 8601, for example: 2025-04-25T14:00:00.\",\"tools\":[{\"name\":\"send_reply\",\"description\":\"Send email reply\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"recipient\":{\"type\":\"string\"},\"subject\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"required\":[\"recipient\",\"subject\",\"message\"]}},{\"name\":\"book_appointment\",\"description\":\"Book appointment\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"service\":{\"type\":\"string\"},\"datetime\":{\"type\":\"string\"},\"notes\":{\"type\":\"string\"}},\"required\":[\"name\",\"service\",\"datetime\"]}},{\"name\":\"log_conversation\",\"description\":\"Log conversation\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"sender\":{\"type\":\"string\"},\"intent\":{\"type\":\"string\"},\"action_taken\":{\"type\":\"string\"}},\"required\":[\"sender\",\"intent\",\"action_taken\"]}},{\"name\":\"escalate_to_human\",\"description\":\"Escalate to human\",\"input_schema\":{\"type\":\"object\",\"properties\":{\"reason\":{\"type\":\"string\"}},\"required\":[\"reason\"]}}],\"messages\":[{\"role\":\"user\",\"content\":' + _dp('{\"pill_type\":\"output\",\"provider\":\"workato_variable\",\"line\":\"21b55052\",\"path\":[\"clean_body\"]}').to_json + '}]}'"
